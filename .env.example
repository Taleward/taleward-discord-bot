# Kopie als .env anlegen und ausfüllen. Die .env kommt nie ins Repo.

# Discord-Anwendung (https://discord.com/developers/applications, Anleitung in docs/anleitung-start.md).
# Schlüssel des Bots (Reiter Bot, "Reset Token"). Geheim.
DISCORD_TOKEN=
# Anwendungs-ID (Reiter General Information, "Application ID")
DISCORD_ANWENDUNG_ID=

# Taleward-Server, zu dem dieser Bot gehört (öffentliche https-Adresse, ohne Schrägstrich am Ende). Pflicht, sobald
# TALEWARD_BOT_SCHLUESSEL gesetzt ist: Der Schlüssel geht nur an den Server, der ihn ausgestellt hat.
TALEWARD_SERVER_URL=
# Bot-Schlüssel aus der Verwaltung dieses Servers (Discord-Bot → Schlüssel erzeugen, wird einmal angezeigt). Geheim.
# Damit gilt /taleward auf jedem Discord-Server, dessen Kampagne verbunden ist; Zustimmung, Spielleitung,
# Runde und Hochladen kommen vom Server.
TALEWARD_BOT_SCHLUESSEL=

# Freiwillige Helfer für den eigenen Discord-Server (/faq, /taleward-status, /feedback, /tester-knopf).
# Leer lassen, wenn nur /taleward gebraucht wird. Wird DISCORD_HEIM_GILDE gesetzt, müssen alle drei gesetzt sein.
# Kennung des Discord-Servers (Entwicklermodus, Rechtsklick auf den Servernamen, "Server-ID kopieren")
DISCORD_HEIM_GILDE=
# Kennung der Rolle, die der Tester-Knopf vergibt (Servereinstellungen, Rollen, Rechtsklick, "Rollen-ID kopieren")
DISCORD_TESTER_ROLLE=
# Kennung des privaten Kanals für Rückmeldungen (Rechtsklick auf den Kanal, "Kanal-ID kopieren")
DISCORD_RUECKMELDUNG_KANAL=

# Adressen der Helfer, mit Standardwerten (zeigen auf taleward.org; für den eigenen Discord eigene eintragen):
# TALEWARD_FAQ_URL=https://taleward.org/faq.json
# TALEWARD_FAQ_SEITE=https://taleward.org/fuer-gruppen/#faq
# TALEWARD_FAQ_SEITE_EN=https://taleward.org/en/for-groups/#faq
# TALEWARD_TESTER_SEITE=https://taleward.org/pilotrunden/
# TALEWARD_TESTER_SEITE_EN=https://taleward.org/en/pilot-tables/
# TALEWARD_SICHERHEITS_MAIL=info@taleward.org
# TALEWARD_GITHUB_ORG=Taleward

# Testmodus ohne Server (statt TALEWARD_BOT_SCHLUESSEL, nur zusammen mit DISCORD_HEIM_GILDE): Klartext-Spuren,
# kein Hochladen, nur mit schriftlicher Zustimmung aller aufgenommenen Personen. Die alten Namen PROBE_* gelten weiter.
# Discord-Kennung der Spielleitung (startet, hält an, beendet).
# AUFNAHME_LEITUNG=
# Discord-Kennungen aller Personen mit schriftlicher Zustimmung, durch Komma getrennt, höchstens 12.
# Nur diese Personen werden aufgenommen; alle anderen im Kanal nie.
# AUFNAHME_TEILNEHMER=
# Ordner für die Aufnahmen im Container (Standard /aufnahmen, siehe docker-compose.yml).
# AUFNAHME_ORDNER=/aufnahmen
