{
  "name": "taleward-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-Bot fuer Taleward: nimmt Online-Runden auf und bringt die Spuren zum Taleward-Server der Gruppe",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "befehle": "node --env-file-if-exists=.env dist/befehle-registrieren.js",
    "test": "npm run build && node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@hpke/common": "1.10.1",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@snazzah/davey": "0.1.12",
    "discord.js": "14.27.0",
    "prism-media": "1.3.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
